# Copy to .env only inside a trusted runtime.
# Never commit .env or paste secret values into chat.

APP_ENV=development
PAPER_TRADING_ONLY=true

# Optional integrations; leave empty until deliberately configured.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Optional vision/reasoning provider; configure later in a secret manager.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
